# Copy these keys into ~/.env and run: chmod 600 ~/.env
# Never put real people, phone numbers, tokens, or message content in this repository.
WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-value
WHATSAPP_APP_SECRET=replace-with-the-meta-app-secret
WHATSAPP_ACCESS_TOKEN=replace-with-a-system-user-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-the-phone-number-id
WHATSAPP_GRAPH_API_VERSION=v23.0
ADMIN_TOKEN=replace-with-a-long-random-value
DEVICE_RELAY_SECRET=replace-with-an-independent-long-random-value
PORT=3000
OUTBOUND_MODE=console
CALENDAR_DIRECTORY=./data/calendar
